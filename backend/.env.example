# Used by docker-compose to create the local Postgres container
POSTGRES_USER=techtrendspotter
POSTGRES_PASSWORD=techtrendspotter
POSTGRES_DB=techtrendspotter

# Used by the backend to connect to Postgres
DATABASE_URL=postgresql://techtrendspotter:techtrendspotter@localhost:5432/techtrendspotter

# Comma-separated frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173
