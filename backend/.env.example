# Used by docker-compose to create the local Postgres container
POSTGRES_USER=techtrendspotter
POSTGRES_PASSWORD=techtrendspotter
POSTGRES_DB=techtrendspotter

# Used by the backend to connect to Postgres
DATABASE_URL=postgresql://techtrendspotter:techtrendspotter@localhost:5432/techtrendspotter

# Comma-separated frontend origins allowed by CORS
FRONTEND_ORIGINS=http://localhost:5173

# Data collection - generic bot name sent to sources (no personal details)
COLLECTOR_USER_AGENT=TechTrendSpotterBot/0.1
# Per-request timeout in seconds for external sources
COLLECTOR_TIMEOUT_SECONDS=10
# Optional: path to the data collection sources file (defaults to functionality/data_collection/sources.yaml)
# SOURCES_CONFIG_PATH=
# Optional: GitHub token for the GitHub Security Advisories collector (raises the rate limit
# from 60 to 5,000 requests/hour). Use a fine-grained token with no permissions.
# GITHUB_TOKEN=
# Minimum seconds between collection runs started from the dashboard (default 300)
# COLLECTION_RUN_COOLDOWN_SECONDS=300
